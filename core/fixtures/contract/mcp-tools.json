          "limit": {
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          },
          "person_id": {
            "type": "string"
          },
          "who": {
            "description": "人名或别名",
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "person"
    },
    {
