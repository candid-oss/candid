<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<!-- Widgets must be sandboxed. The only file access is read-only to the
     aggregates the app writes for it; no screenshots or window text live there. -->
<key>com.apple.security.app-sandbox</key><true/>
<key>com.apple.security.temporary-exception.files.home-relative-path.read-only</key>
<array><string>/Library/Application Support/Candid/widget/</string></array>
</dict></plist>
